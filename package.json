{
  "name": "for-mark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -s first \"vite\" \"wait-on tcp:127.0.0.1:5173 && ELECTRON_RENDERER_URL=http://localhost:5173 electron .\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@milkdown/kit": "^7.0.0",
    "@milkdown/plugin-diagram": "^7.0.0",
    "@milkdown/plugin-prism": "^7.22.1",
    "mermaid": "^11.0.0",
    "refractor": "^5.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.chiangyang.for-mark",
    "productName": "for-mark",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    }
  }
}
